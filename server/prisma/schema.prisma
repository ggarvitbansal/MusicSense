// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MusicalMode {
  MAJOR
  MINOR
}

enum ModelType {
  TENSORFLOW
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  musicFiles   MusicFile[]
  settings     UserSettings?
}

model MusicFile {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  originalName String
  storedName   String
  storagePath  String
  mimeType     String
  format       String
  fileSize     Int
  duration     Float
  uploadedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis     AudioAnalysis?
}

model AudioAnalysis {
  id              String      @id @default(uuid()) @db.Uuid
  musicFileId     String      @unique @db.Uuid
  genre           String
  tempo           Float
  musicalKey      String
  mode            MusicalMode
  energy          Float
  danceability    Float
  valence         Float
  analysisVersion String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  musicFile       MusicFile   @relation(fields: [musicFileId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  theme          String    @default("dark")
  preferredModel ModelType @default(TENSORFLOW)
  notifications  Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
